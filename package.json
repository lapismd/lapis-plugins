{
  "name": "@lapis-notes/plugins-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "First-party plugins for Lapis applications",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/validation.mjs run build",
    "changeset": "changeset",
    "audit": "node scripts/audit.mjs",
    "check": "node scripts/validation.mjs run check",
    "check:app-ownership": "node scripts/validation.mjs run check:app-ownership",
    "check:no-tailwind": "node scripts/validation.mjs run check:no-tailwind",
    "packages:check": "node scripts/validation.mjs run packages:check",
    "packages:sync": "node scripts/sync-package-metadata.mjs --write && node scripts/sync-package-docs.mjs --write",
    "test": "node scripts/validation.mjs run test",
    "test:release": "node scripts/validation.mjs run test:release",
    "packages:pack": "node scripts/validation.mjs run packages:pack",
    "plugin:build": "node scripts/build-plugin-release.mjs",
    "plugin:verify": "node scripts/verify-plugin-release.mjs",
    "registry:media:capture": "node scripts/capture-registry-media.mjs",
    "registry:media:check": "node scripts/capture-registry-media.mjs --check",
    "release:version": "node scripts/version-public-packages.mjs",
    "release:plan": "node scripts/create-release-plan.mjs",
    "release:nostr": "node scripts/nostr-release.mjs",
    "release:nostr:renew": "node scripts/renew-registry-heads.mjs",
    "release:nostr:verify": "node scripts/verify-nostr-release.mjs",
    "release:dispatch-metadata": "node scripts/dispatch-plugin-metadata.mjs",
    "release:publish-approved": "node scripts/publish-approved-release.mjs",
    "ci:packages": "node scripts/validation.mjs run ci:packages",
    "ci:release": "node scripts/validation.mjs run ci:release",
    "ci:container": "node --env-file-if-exists=.env scripts/run-ci-container.mjs",
    "release:prepare": "pnpm ci:release",
    "storybook": "storybook dev -p 6006 --no-open",
    "dev:sync": "pnpm --dir packages/sync build && vite --config dev/sync/vite.config.mjs",
    "build-storybook": "node scripts/validation.mjs run build-storybook",
    "test:storybook": "node scripts/validation.mjs run test:storybook",
    "spec:validate": "spec-validator validate",
    "spec:check": "spec-validator check",
    "spec:first": "spec-validator first",
    "spec:build": "spec-validator build",
    "spec:serve": "spec-validator serve",
    "spec:search": "spec-validator search",
    "spec:index": "spec-validator index",
    "spec:sync-verification": "node scripts/sync-spec-verification.mjs",
    "test:release:nostr": "node scripts/validation.mjs run test:release:nostr",
    "validation:check": "node scripts/validation.mjs run validation:check",
    "validation:smoke": "node scripts/validation.mjs run validation:smoke",
    "validation": "node scripts/validation.mjs",
    "validation:images": "node scripts/validation.mjs images",
    "validation:doctor": "node scripts/validation.mjs doctor",
    "check:storybook-parity": "node scripts/validation.mjs run check:storybook-parity",
    "test:storybook-parity": "node scripts/validation.mjs run test:storybook-parity",
    "validation:sync": "node scripts/validation.mjs run validation:sync"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-code-pro": "5.3.0",
    "@lapis-notes/api": "^0.2.3",
    "@lapis-notes/file-explorer": "^0.2.0",
    "@lapis-notes/history": "^0.1.4",
    "@lapis-notes/language-service": "^0.1.2",
    "@lapis-notes/ui": "^0.1.5",
    "@lapis-notes/workspace": "^0.3.1",
    "@lapismd/design-core": "^0.7.2",
    "@lapismd/mira": "~0.1.3",
    "@lapismd/mira-editor": "~0.0.3",
    "@lapismd/mira-plugin-ai": "~0.0.3",
    "@lapismd/mira-plugin-mermaid": "~0.0.3",
    "@lapismd/spec-validator": "^0.2.0",
    "@lapismd/storybook-addon-visual-delta": "0.0.7",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.2",
    "@lezer/markdown": "^1.4.3",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/icons": "^2.1.0",
    "@storybook/svelte-vite": "^10.6.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "aria-query": "5.3.2",
    "character-entities": "2.0.2",
    "debug": "^4.4.3",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.25.12",
    "extend": "^3.0.2",
    "fflate": "^0.8.3",
    "i18next": "^25.3.0",
    "jsdom": "26.1.0",
    "markdownlint": "^0.40.0",
    "publint": "^0.3.12",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.5",
    "storybook": "^10.6.2",
    "svelte": "5.56.10",
    "svelte-check": "^4.3.1",
    "svelte-sonner": "^1.0.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.12"
  }
}
