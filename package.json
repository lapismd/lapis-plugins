{
  "name": "@lapis-notes/plugins-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "First-party plugins for Lapis applications",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm packages:check && pnpm check:app-ownership && pnpm check:no-tailwind && turbo run check",
    "check:app-ownership": "node scripts/check-app-ownership.mjs",
    "check:no-tailwind": "node scripts/check-no-tailwind.mjs",
    "packages:check": "node scripts/sync-package-metadata.mjs --check && node scripts/sync-package-docs.mjs --check && node scripts/check-package-boundaries.mjs",
    "packages:sync": "node scripts/sync-package-metadata.mjs --write && node scripts/sync-package-docs.mjs --write",
    "test": "turbo run test",
    "test:release": "node --test scripts/*.test.mjs",
    "packages:pack": "pnpm build && node scripts/pack-packages.mjs",
    "plugin:build": "node scripts/build-plugin-release.mjs",
    "plugin:verify": "node scripts/verify-plugin-release.mjs",
    "release:version": "changeset version",
    "release:plan": "node scripts/create-release-plan.mjs",
    "release:publish-approved": "node scripts/publish-approved-release.mjs",
    "release:prepare": "pnpm packages:check && pnpm spec:check && pnpm check && pnpm test && pnpm test:release && pnpm build && pnpm packages:pack && pnpm plugin:build && pnpm plugin:verify && pnpm build-storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "spec:first": "spec-validator first",
    "spec:check": "spec-validator check && pnpm check:app-ownership",
    "spec:sync-verification": "node scripts/sync-spec-verification.mjs",
    "spec:validate": "spec-validator validate"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lapis-notes/api": "^0.1.0",
    "@lapis-notes/file-explorer": "^0.1.0",
    "@lapis-notes/language-service": "^0.1.0",
    "@lapis-notes/ui": "^0.1.0",
    "@lapis-notes/workspace": "^0.1.0",
    "@lapismd/ai-host": "^0.1.0",
    "@lapismd/design-core": "^0.1.0",
    "@lapismd/mira": "^0.0.1",
    "@lapismd/mira-editor": "^0.0.1",
    "@lapismd/mira-plugin-ai": "^0.0.1",
    "@lapismd/mira-plugin-mermaid": "^0.0.1",
    "@lapismd/spec-validator": "0.1.0",
    "@lapismd/storybook-addon-visual-delta": "0.0.7",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.4.3",
    "@lezer/lr": "^1.4.2",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/svelte-vite": "^10.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.10.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.8",
    "aria-query": "5.3.2",
    "character-entities": "2.0.2",
    "debug": "^4.4.3",
    "esbuild": "^0.25.12",
    "es-module-lexer": "^1.7.0",
    "extend": "^3.0.2",
    "fflate": "^0.8.3",
    "jsdom": "26.1.0",
    "markdownlint": "^0.40.0",
    "publint": "^0.3.12",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "tsx": "^4.23.1",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.8"
  }
}
