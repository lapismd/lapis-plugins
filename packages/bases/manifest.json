{
  "id": "bases",
  "name": "Bases",
  "version": "0.1.2",
  "minAppVersion": "0.1.0",
  "description": "Bases",
  "author": "Lapis Notes Bases",
  "authorUrl": "https://app.lapis.md",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api",
            "@lapis-notes/api/editor",
            "@lapis-notes/api/editor/core",
            "@lapis-notes/api/editor/extensions/class-highlighter",
            "@lapis-notes/api/icon",
            "@lapis-notes/api/metadata-value"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
