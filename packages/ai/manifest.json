{
  "id": "ai",
  "name": "AI",
  "version": "0.1.3",
  "minAppVersion": "0.1.0",
  "description": "Provider-agnostic agent chat with ACP and optional native runtimes.",
  "author": "Lapis Notes",
  "authorAvatarUrl": "https://www.gravatar.com/avatar/1df68d9ff087b0dd72fd8626056fca7f?s=128&d=404",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api",
            "@lapis-notes/api/agent-skills",
            "@lapis-notes/api/agent-tools",
            "@lapis-notes/api/app-database",
            "@lapis-notes/api/desktop-native",
            "@lapis-notes/api/path",
            "@lapis-notes/api/vault",
            "@lapis-notes/api/workspace-host",
            "@lapis-notes/markdown/embed",
            "@codemirror/autocomplete",
            "@codemirror/commands",
            "@codemirror/language",
            "@codemirror/state",
            "@codemirror/view",
            "@lezer/common",
            "@lezer/highlight",
            "@lezer/lr",
            "svelte/renderer/5.56.10",
            "svelte/renderer/5.56.10/attachments",
            "svelte/renderer/5.56.10/events",
            "svelte/renderer/5.56.10/internal/client",
            "svelte/renderer/5.56.10/internal/disclose-version",
            "svelte/renderer/5.56.10/internal/flags/legacy",
            "svelte/renderer/5.56.10/reactivity",
            "svelte/renderer/5.56.10/store"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
