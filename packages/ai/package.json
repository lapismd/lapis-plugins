{
  "name": "@lapis-notes/ai",
  "version": "0.1.7",
  "description": "Lapis Notes provider-agnostic AI agent plugin",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint",
    "publint": "publint",
    "pack": "pnpm pack --pack-destination ../../.release/npm"
  },
  "files": [
    "dist",
    "manifest.json",
    "registry.json",
    "registry-content",
    "styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./runtimes": {
      "types": "./dist/runtime-adapters.d.ts",
      "svelte": "./dist/runtime-adapters.js",
      "import": "./dist/runtime-adapters.js",
      "default": "./dist/runtime-adapters.js"
    },
    "./manifest.json": "./manifest.json",
    "./registry.json": "./registry.json"
  },
  "dependencies": {
    "@lapismd/ai-controller": "^0.1.0",
    "@lapismd/design-core": "^0.10.1",
    "@lucide/svelte": "^0.523.0",
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lapis-notes/api": "^0.2.0",
    "@lapis-notes/markdown": "^0.2.2",
    "@lapis-notes/ui": "^0.1.4",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.2",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@lapis-notes/markdown": "^0.2.2",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^24.0.0",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugins.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/lapismd/lapis-plugins/tree/main/packages/ai#readme",
  "bugs": {
    "url": "https://github.com/lapismd/lapis-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
