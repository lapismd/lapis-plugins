{
  "id": "lapis-slides",
  "name": "Slides",
  "version": "0.1.0",
  "minAppVersion": "0.1.0",
  "description": "Presentation mode for Markdown notes",
  "author": "Lapis Notes",
  "authorUrl": "https://app.lapis.md",
  "authorAvatarUrl": "https://www.gravatar.com/avatar/1df68d9ff087b0dd72fd8626056fca7f?s=128&d=404",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api",
            "@lapis-notes/markdown/embed"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
