{
  "$schema": "https://registry.lapis.md/schemas/plugin-source.schema.json",
  "schemaVersion": 1,
  "categories": ["navigation", "productivity"],
  "highlights": [
    "Bookmark files, folders, searches, and grouped destinations.",
    "Open saved workspace locations from one compact panel.",
    "Organize frequently used resources without changing vault content."
  ],
  "documentationUrl": "https://github.com/lapismd/lapis-plugins/tree/main/packages/bookmarks#readme",
  "appearance": { "icon": "bookmark", "accent": "#E11D48" },
  "gallery": [
    {
      "id": "bookmarks-sidebar",
      "alt": "Bookmarks sidebar containing saved notes, a folder, a search, a URL, and a graph shortcut.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/bookmarks-sidebar.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/bookmarks-sidebar.full.webp"
        }
      },
      "capture": {
        "storyId": "plugins-bookmarks-registry-screenshots--bookmarks-sidebar",
        "focus": "right-sidebar"
      },
      "card": {
        "headline": [
          { "text": "Keep every useful place", "tone": "neutral" },
          { "text": "one click away", "tone": "rose" }
        ],
        "description": [
          {
            "text": "Save notes, headings, folders, searches, URLs, and graph views in one familiar tree.",
            "tone": "neutral"
          }
        ]
      }
    }
  ],
  "content": {
    "overview": "registry-content/overview.md",
    "changelog": "CHANGELOG.md"
  }
}
