{
  "id": "bookmarks",
  "name": "Bookmarks",
  "version": "0.1.1",
  "minAppVersion": "0.1.0",
  "description": "Bookmark files, folders, searches, and groups",
  "author": "Lapis Notes",
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
