{
  "id": "bookmarks",
  "name": "Bookmarks",
  "version": "0.1.2",
  "minAppVersion": "0.1.0",
  "description": "Bookmark files, folders, searches, and groups",
  "author": "Lapis Notes",
  "authorAvatarUrl": "https://www.gravatar.com/avatar/1df68d9ff087b0dd72fd8626056fca7f?s=128&d=404",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api",
            "@codemirror/autocomplete",
            "@codemirror/commands",
            "@codemirror/language",
            "@codemirror/state",
            "@codemirror/view",
            "@lezer/common",
            "@lezer/highlight",
            "@lezer/lr",
            "svelte/renderer/5.56.10",
            "svelte/renderer/5.56.10/attachments",
            "svelte/renderer/5.56.10/events",
            "svelte/renderer/5.56.10/internal/client",
            "svelte/renderer/5.56.10/internal/disclose-version",
            "svelte/renderer/5.56.10/internal/flags/legacy",
            "svelte/renderer/5.56.10/reactivity"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
