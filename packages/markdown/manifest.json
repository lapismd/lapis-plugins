{
  "id": "markdown",
  "name": "Markdown",
  "author": "Lapis Notes",
  "authorAvatarUrl": "https://www.gravatar.com/avatar/1df68d9ff087b0dd72fd8626056fca7f?s=128&d=404",
  "version": "0.1.7",
  "minAppVersion": "0.1.0",
  "description": "Mira-powered Markdown editing with source, live preview, and reading modes.",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api",
            "@lapis-notes/api/agent-tools",
            "@lapis-notes/api/editor",
            "@lapis-notes/api/editor/core",
            "@lapis-notes/api/editor/language-service",
            "@lapis-notes/api/icon",
            "@lapis-notes/api/vault",
            "@lapis-notes/api/workspace-host",
            "@codemirror/autocomplete",
            "@codemirror/commands",
            "@codemirror/language",
            "@codemirror/lint",
            "@codemirror/search",
            "@codemirror/state",
            "@codemirror/view",
            "@lezer/common",
            "@lezer/highlight",
            "@lezer/lr",
            "svelte/renderer/5.56.10",
            "svelte/renderer/5.56.10/attachments",
            "svelte/renderer/5.56.10/events",
            "svelte/renderer/5.56.10/internal/client",
            "svelte/renderer/5.56.10/internal/disclose-version",
            "svelte/renderer/5.56.10/reactivity"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
