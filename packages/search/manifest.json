{
  "id": "search",
  "name": "Search",
  "version": "0.1.0",
  "minAppVersion": "0.1.0",
  "description": "Search files, metadata, tags, and note content.",
  "author": "Lapis Notes",
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api",
            "@lapis-notes/api/agent-skills",
            "@lapis-notes/api/agent-tools"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
