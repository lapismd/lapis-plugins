          {
            "text": "and structured semantic matching",
            "tone": "violet"
          },
          {
            "text": "from one compact panel.",
            "tone": "neutral"
          }
        ]
      }
    }
  ],
  "content": {
    "overview": "registry-content/overview.md",
    "changelog": "CHANGELOG.md"
  }
