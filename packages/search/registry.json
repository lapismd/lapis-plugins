{
  "$schema": "https://registry.lapis.md/schemas/plugin-source.schema.json",
  "schemaVersion": 1,
  "categories": ["navigation", "search"],
  "highlights": [
    "Search file names, metadata, tags, and note content.",
    "Open results in the workspace from a reusable search panel.",
    "Expose scoped search capabilities to compatible agent tools."
  ],
  "documentationUrl": "https://github.com/lapismd/lapis-plugins/tree/main/packages/search#readme",
  "appearance": {
    "icon": "search",
    "accent": "#F59E0B"
  },
  "media": {
    "banner": {
      "alt": "Lapis Search with populated indexed results in the primary left sidebar beside an empty main workspace.",
      "images": {
        "preview": {
          "path": "registry-assets/banner.preview.webp"
        },
        "full": {
          "path": "registry-assets/banner.full.webp"
        },
        "light": {
          "path": "registry-assets/banner.light.webp"
        },
        "dark": {
          "path": "registry-assets/banner.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-search-registry-screenshots--overview",
        "focus": "left-sidebar"
      }
    },
    "overview": {
      "alt": "Lapis Search with populated indexed results in the primary left sidebar beside an empty main workspace.",
      "images": {
        "preview": {
          "path": "registry-assets/overview.preview.webp"
        },
        "full": {
          "path": "registry-assets/overview.full.webp"
        },
        "light": {
          "path": "registry-assets/overview.light.webp"
        },
        "dark": {
          "path": "registry-assets/overview.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-search-registry-screenshots--overview",
        "focus": "full-shell"
      }
    }
  },
  "gallery": [
    {
      "id": "search-sidebar",
      "alt": "Left Search sidebar showing populated indexed results and expanded match context from notes and metadata.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/search-sidebar.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/search-sidebar.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/search-sidebar.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/search-sidebar.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-search-registry-screenshots--search-sidebar",
        "focus": "left-sidebar"
      },
      "card": {
        "headline": [
          {
            "text": "Find the right note",
            "tone": "neutral"
          },
          {
            "text": "from one query",
            "tone": "amber"
          }
        ],
        "description": [
          {
            "text": "Search",
            "tone": "neutral"
          },
          {
            "text": "filenames, properties, tags, and content",
            "tone": "amber"
          },
          {
            "text": "from a reusable indexed sidebar.",
            "tone": "neutral"
          }
        ]
      }
    },
    {
      "id": "search-filters",
      "alt": "Left Search sidebar with populated results and its file type, retrieval, and view settings open.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/search-filters.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/search-filters.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/search-filters.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/search-filters.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-search-registry-screenshots--search-filters",
        "focus": "left-sidebar"
      },
      "card": {
        "headline": [
          {
            "text": "Shape every query",
            "tone": "neutral"
          },
          {
            "text": "without leaving Search",
            "tone": "cyan"
          }
        ],
        "description": [
          {
            "text": "Tune",
            "tone": "neutral"
          },
          {
            "text": "file type, retrieval, case, context,",
            "tone": "amber"
