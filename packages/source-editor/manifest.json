{
  "id": "lapis-source-editor",
  "name": "Source Editor",
  "version": "0.1.2",
  "minAppVersion": "0.1.0",
  "description": "Source editing for text, JSON, and YAML files",
  "author": "Lapis Notes",
  "authorUrl": "https://app.lapis.md",
  "authorAvatarUrl": "https://gravatar.com/avatar/f7226d5f9cf07af2a6a60d3ab11413abb9d2e2eb60f2d5cce17356845a166155?size=256&d=initials",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api",
            "@lapis-notes/api/editor",
            "@lapis-notes/api/workspace-host",
            "@codemirror/language",
            "@lezer/common",
            "@lezer/highlight",
            "@lezer/lr"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
