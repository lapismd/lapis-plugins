{
  "$schema": "https://registry.lapis.md/schemas/plugin-source.schema.json",
  "schemaVersion": 1,
  "categories": ["editor", "source"],
  "highlights": [
    "Edit text, JSON, and YAML files with syntax-aware source views.",
    "Open supported files through normal workspace routing.",
    "Keep edits synchronized through the Lapis vault lifecycle."
  ],
  "documentationUrl": "https://github.com/lapismd/lapis-plugins/tree/main/packages/source-editor#readme",
  "appearance": {
    "icon": "file-code-2",
    "accent": "#0EA5E9"
  },
  "media": {
    "banner": {
      "alt": "Lapis Source Editor showing a populated JSON document in the complete shell with both sidebars closed.",
      "images": {
        "preview": {
          "path": "registry-assets/banner.preview.webp"
        },
        "full": {
          "path": "registry-assets/banner.full.webp"
        },
        "light": {
          "path": "registry-assets/banner.light.webp"
        },
        "dark": {
          "path": "registry-assets/banner.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-source-editor-registry-screenshots--overview",
        "focus": "full-shell"
      }
    }
  },
  "gallery": [
    {
      "id": "json-editor",
      "alt": "Focused syntax-highlighted project settings JSON editor filling the workspace.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/json-editor.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/json-editor.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/json-editor.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/json-editor.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-source-editor-registry-screenshots--json-editor",
        "focus": "full-shell"
      },
      "card": {
        "headline": [
          {
            "text": "Edit JSON and YAML",
            "tone": "neutral"
          },
          {
            "text": "in the same workspace",
            "tone": "cyan"
          }
        ],
        "description": [
          {
            "text": "Open",
            "tone": "neutral"
          },
          {
            "text": "JSON, YAML, and text",
            "tone": "cyan"
          },
          {
            "text": "through normal Lapis routing with syntax-aware editing.",
            "tone": "neutral"
          }
        ]
      }
    }
  ],
  "content": {
    "overview": "registry-content/overview.md",
    "changelog": "CHANGELOG.md"
  }
}
