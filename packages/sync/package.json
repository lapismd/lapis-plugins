{
  "name": "@lapis-notes/lapis-plugin-sync",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "description": "Nostr-compatible Lapis Sync protocol with configurable destinations",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md",
    "README.md",
    "manifest.json",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "svelte": "./dist/components.js",
      "import": "./dist/components.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "default": "./dist/engine.js"
    },
    "./styles.css": "./dist/styles.css",
    "./manifest.json": "./manifest.json"
  },
  "scripts": {
    "check": "pnpm check:engine && pnpm check:svelte",
    "test": "vitest run",
    "build": "svelte-package --input src --output dist --tsconfig tsconfig.app.json && node build.mjs",
    "prepack": "pnpm build && publint",
    "publint": "publint",
    "check:engine": "tsc -p tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig tsconfig.app.json --fail-on-warnings --output human"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "nostr-tools": "^2.25.2",
    "@lapismd/design-core": "^0.7.4",
    "@lucide/svelte": "^0.523.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@noble/ciphers": "^1.3.0",
    "esbuild": "^0.25.12",
    "publint": "^0.3.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/node": "^24.10.0",
    "@lapis-notes/api": "^0.2.3",
    "@lapismd/mira": "~0.1.4",
    "svelte": "5.56.10",
    "svelte-check": "^4.3.1",
    "vite": "^7.3.2",
    "@lapis-notes/ui": "^0.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugins.git",
    "directory": "packages/sync"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@lapis-notes/api": "^0.2.0",
    "svelte": "^5.0.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93753"
      ]
    },
    "overrides": {
      "bits-ui": "2.20.2",
      "katex@>=0.11.0 <0.18.2": ">=0.18.2 <0.19",
      "body-parser@>=2.0.0 <2.4.0": ">=2.4.0 <3",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9 <4"
    },
    "patchedDependencies": {
      "bits-ui@2.20.2": "../../patches/bits-ui@2.20.2.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
