{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/engine.ts", "src/protocol/**/*.ts", "src/objects/**/*.ts", "src/runtime/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
