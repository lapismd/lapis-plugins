{
  "$schema": "https://registry.lapis.md/schemas/plugin-source.schema.json",
  "schemaVersion": 2,
  "categories": ["sync", "history"],
  "highlights": [
    "Review pending vault changes and enrolled devices.",
    "Follow revisions across devices and compare file content.",
    "Resolve divergent edits before publishing a merge."
  ],
  "documentationUrl": "https://github.com/lapismd/lapis-plugins/tree/main/packages/sync#readme",
  "appearance": {
    "icon": "refresh-cw",
    "accent": "#0EA5E9"
  },
  "media": {
    "banner": {
      "alt": "Lapis Sync with Explorer, branched revision history and README comparison, and pending changes in the right dock.",
      "images": {
        "preview": {
          "path": "registry-assets/banner.preview.webp"
        },
        "full": {
          "path": "registry-assets/banner.full.webp"
        },
        "light": {
          "path": "registry-assets/banner.light.webp"
        },
        "dark": {
          "path": "registry-assets/banner.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-sync-registry-screenshots--banner",
        "focus": "full-shell"
      }
    }
  },
  "gallery": [
    {
      "id": "changes",
      "alt": "Sync dock showing pending changes, enrolled device tips, and checkpoint actions.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/changes.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/changes.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/changes.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/changes.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-sync-registry-screenshots--changes",
        "focus": "right-sidebar"
      },
      "card": {
        "headline": [
          {
            "text": "Review changes",
            "tone": "neutral"
          },
          {
            "text": "across devices",
            "tone": "cyan"
          }
        ],
        "description": [
          {
            "text": "See pending vault edits and device tips before creating a checkpoint.",
            "tone": "neutral"
          }
        ]
      }
    },
    {
      "id": "history",
      "alt": "Branched Sync revision graph with edits from the laptop and phone.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/history.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/history.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/history.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/history.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-sync-registry-screenshots--history",
        "focus": "full-shell"
      },
      "card": {
        "headline": [
          {
            "text": "Follow your vault",
            "tone": "neutral"
          },
          {
            "text": "through every revision",
            "tone": "cyan"
          }
        ],
        "description": [
          {
            "text": "Browse device branches, checkpoints, and merges in one revision timeline.",
            "tone": "neutral"
          }
        ]
      }
    },
    {
      "id": "file-history",
      "alt": "README file history and content comparison with actions in its header.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/file-history.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/file-history.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/file-history.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/file-history.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-sync-registry-screenshots--file-history",
        "focus": "full-shell"
      },
      "card": {
        "headline": [
          {
            "text": "Compare a file",
            "tone": "neutral"
          },
          {
            "text": "before restoring",
            "tone": "cyan"
          }
        ],
        "description": [
          {
            "text": "Inspect changed lines and earlier file versions with unified or split comparisons.",
            "tone": "neutral"
          }
        ]
      }
    },
    {
      "id": "merge",
      "alt": "Three-way merge editor resolving laptop and phone versions of README.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/merge.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/merge.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/merge.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/merge.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-sync-registry-screenshots--merge",
        "focus": "full-shell"
      },
      "card": {
        "headline": [
          {
            "text": "Resolve divergent edits",
            "tone": "neutral"
          },
          {
            "text": "with both versions in view",
            "tone": "cyan"
          }
        ],
        "description": [
          {
            "text": "Review the base, local, and remote content before publishing a merge revision.",
            "tone": "neutral"
          }
        ]
      }
    },
    {
      "id": "status",
      "alt": "Synced status popover with Lapis Server connection health and copyable encrypted revision identifiers.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/status.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/status.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/status.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/status.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-sync-registry-screenshots--status",
        "focus": "full-shell"
      },
      "card": {
        "headline": [
          {
            "text": "Know when everything",
            "tone": "neutral"
          },
          {
            "text": "is in sync",
            "tone": "green"
          }
        ],
        "description": [
          {
            "text": "Check server health, pending changes, and revision details directly from the status bar.",
            "tone": "neutral"
          }
        ]
      }
    }
  ]
}
