      "name": "sorts nested object keys",
      "input": { "z": { "b": 2, "a": 1 }, "a": [3, 2, 1] },
      "output": "{\"a\":[3,2,1],\"z\":{\"a\":1,\"b\":2}}"
    },
    {
      "name": "uses ECMAScript number rendering",
      "input": [1.0, -0.0, 1e21, 1e-7, 0.000001],
      "output": "[1,0,1e+21,1e-7,0.000001]"
    },
    {
      "name": "retains prototype-shaped own keys",
      "input": {
        "prototype": "value",
        "__proto__": { "polluted": true },
        "constructor": "value"
      },
      "output": "{\"__proto__\":{\"polluted\":true},\"constructor\":\"value\",\"prototype\":\"value\"}"
    },
    {
      "name": "escapes strings without whitespace",
      "input": { "line": "one\ntwo", "quote": "say \"hi\"", "unicode": "λ" },
      "output": "{\"line\":\"one\\ntwo\",\"quote\":\"say \\\"hi\\\"\",\"unicode\":\"λ\"}"
    }
