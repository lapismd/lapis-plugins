{
  "name": "@lapis-notes/docx",
  "version": "0.1.0",
  "description": "Word document file view and note embed for Lapis applications",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "prepack": "svelte-package --input src --output dist --tsconfig ./tsconfig.pack.json && publint",
    "publint": "publint",
    "pack": "pnpm pack --pack-destination ../../.release/npm"
  },
  "files": [
    "dist",
    "manifest.json",
    "registry.json",
    "registry-content",
    "styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./registry.json": "./registry.json",
    "./styles.css": "./styles.css"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.7",
    "buffer": "^6.0.3",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "pdfkit": "^0.19.0",
    "process": "^0.11.10",
    "txml": "^6.0.0"
  },
  "peerDependencies": {
    "@lapis-notes/api": "^0.1.2",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugins.git",
    "directory": "packages/docx"
  },
  "homepage": "https://github.com/lapismd/lapis-plugins/tree/main/packages/docx#readme",
  "bugs": {
    "url": "https://github.com/lapismd/lapis-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
