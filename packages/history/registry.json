{
  "$schema": "https://registry.lapis.md/schemas/plugin-source.schema.json",
  "schemaVersion": 1,
  "categories": ["history", "versioning"],
  "highlights": [
    "Capture bounded local revisions as vault files change.",
    "Compare saved revisions with the current document.",
    "Restore selected content through the normal vault write path."
  ],
  "documentationUrl": "https://github.com/lapismd/lapis-plugins/tree/main/packages/history#readme",
  "appearance": {
    "icon": "history",
    "accent": "#6366F1"
  },
  "media": {
    "banner": {
      "alt": "Lapis History with Explorer on the left, a revision comparison in the main workspace, and History on the right.",
      "images": {
        "preview": {
          "path": "registry-assets/banner.preview.webp"
        },
        "full": {
          "path": "registry-assets/banner.full.webp"
        },
        "light": {
          "path": "registry-assets/banner.light.webp"
        },
        "dark": {
          "path": "registry-assets/banner.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-history-registry-screenshots--overview",
        "focus": "full-shell"
      }
    },
    "overview": {
      "alt": "Lapis History Compare view showing changes between two revisions in the full workspace.",
      "images": {
        "preview": {
          "path": "registry-assets/overview.preview.webp"
        },
        "full": {
          "path": "registry-assets/overview.full.webp"
        },
        "light": {
          "path": "registry-assets/overview.light.webp"
        },
        "dark": {
          "path": "registry-assets/overview.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-history-registry-screenshots--compare",
        "focus": "full-shell"
      }
    }
  },
  "gallery": [
    {
      "id": "history-sidebar",
      "alt": "History sidebar showing saved local revisions for the active Welcome note.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/history-sidebar.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/history-sidebar.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/history-sidebar.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/history-sidebar.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-history-registry-screenshots--history-sidebar",
        "focus": "right-sidebar"
      },
      "card": {
        "headline": [
          {
            "text": "A local timeline",
            "tone": "neutral"
          },
          {
            "text": "for every edit",
            "tone": "amber"
          }
        ],
        "description": [
          {
            "text": "Browse timestamped local snapshots of the active note, with bounded retention and no remote history service.",
            "tone": "neutral"
          }
        ]
      }
    },
    {
      "id": "compare",
      "alt": "History compare view showing a saved revision beside the current Markdown document.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/compare.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/compare.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/compare.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/compare.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-history-registry-screenshots--compare",
        "focus": "full-shell"
      },
      "card": {
        "headline": [
          {
            "text": "Compare changes",
            "tone": "neutral"
          },
          {
            "text": "before restoring",
            "tone": "green"
          }
        ],
        "description": [
          {
            "text": "Review a saved revision against the live document, then restore through the vault.",
            "tone": "neutral"
          }
        ]
      }
    }
  ],
  "content": {
    "overview": "registry-content/overview.md",
    "changelog": "CHANGELOG.md"
  }
}
