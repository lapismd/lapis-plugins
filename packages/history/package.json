{
  "name": "@lapis-notes/history",
  "version": "0.2.0",
  "description": "Lapis Notes file history plugin",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --passWithNoTests && pnpm test:repository",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint",
    "publint": "publint",
    "pack": "pnpm pack --pack-destination ../../.release/npm",
    "test:repository": "node --import tsx --test test/repository/*.test.mjs"
  },
  "files": [
    "dist",
    "manifest.json",
    "registry.json",
    "registry-content",
    "styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./styles.css": "./styles.css",
    "./registry.json": "./registry.json",
    "./repository": {
      "types": "./dist/repository/index.d.ts",
      "svelte": "./dist/repository/index.js",
      "import": "./dist/repository/index.js",
      "default": "./dist/repository/index.js"
    },
    "./repository/controllers/*": {
      "types": "./dist/repository/controllers/*.d.ts",
      "import": "./dist/repository/controllers/*.js",
      "default": "./dist/repository/controllers/*.js"
    },
    "./repository/components/*": {
      "types": "./dist/repository/components/*.d.ts",
      "import": "./dist/repository/components/*.js",
      "default": "./dist/repository/components/*.js"
    },
    "./repository/components/*.svelte": {
      "types": "./dist/repository/components/*.svelte.d.ts",
      "svelte": "./dist/repository/components/*.svelte",
      "default": "./dist/repository/components/*.svelte"
    },
    "./repository/styles/*.css": "./dist/repository/components/*.css"
  },
  "dependencies": {
    "@lapismd/design-core": "^0.7.4",
    "@lucide/svelte": "^1.57.0",
    "@tanstack/svelte-virtual": "^3.13.46"
  },
  "peerDependencies": {
    "@lapis-notes/api": "^0.2.0",
    "@lapismd/jj-history": "^0.1.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@lapismd/jj-history": "0.1.0",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugins.git",
    "directory": "packages/history"
  },
  "homepage": "https://github.com/lapismd/lapis-plugins/tree/main/packages/history#readme",
  "bugs": {
    "url": "https://github.com/lapismd/lapis-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@lapismd/jj-history": {
      "optional": true
    }
  }
}
