{
  "$schema": "https://registry.lapis.md/schemas/plugin-source.schema.json",
  "schemaVersion": 1,
  "categories": ["diagnostics", "linting"],
  "highlights": [
    "Show Markdown diagnostics for open documents.",
    "Apply supported code actions from editor and Problems surfaces.",
    "Configure rule exclusions and path filters per vault."
  ],
  "documentationUrl": "https://github.com/lapismd/lapis-plugins/tree/main/packages/markdown-lint#readme",
  "appearance": {
    "icon": "list-checks",
    "accent": "#F97316"
  },
  "media": {
    "banner": {
      "alt": "Lapis Markdown Lint showing real editor diagnostics and a populated Problems panel with both sidebars closed.",
      "images": {
        "preview": {
          "path": "registry-assets/banner.preview.webp"
        },
        "full": {
          "path": "registry-assets/banner.full.webp"
        },
        "light": {
          "path": "registry-assets/banner.light.webp"
        },
        "dark": {
          "path": "registry-assets/banner.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-markdown-lint-registry-screenshots--overview",
        "focus": "full-shell"
      }
    },
    "overview": {
      "alt": "Lapis Markdown Lint showing real editor diagnostics and a populated Problems panel with both sidebars closed.",
      "images": {
        "preview": {
          "path": "registry-assets/overview.preview.webp"
        },
        "full": {
          "path": "registry-assets/overview.full.webp"
        },
        "light": {
          "path": "registry-assets/overview.light.webp"
        },
        "dark": {
          "path": "registry-assets/overview.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-markdown-lint-registry-screenshots--overview",
        "focus": "full-shell"
      }
    }
  },
  "gallery": [
    {
      "id": "editor-diagnostics",
      "alt": "Focused Markdown editor with inline lint markers and a populated Problems panel listing heading issues.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/editor-diagnostics.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/editor-diagnostics.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/editor-diagnostics.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/editor-diagnostics.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-markdown-lint-registry-screenshots--editor-diagnostics-with-problems",
        "focus": "full-shell"
      },
      "card": {
        "headline": [
          {
            "text": "Catch Markdown issues",
            "tone": "neutral"
          },
          {
            "text": "where you write",
            "tone": "amber"
          }
        ],
        "description": [
          {
            "text": "See",
            "tone": "neutral"
          },
          {
            "text": "diagnostics",
            "tone": "rose"
          },
          {
            "text": "in the editor and the shared Problems surface, with",
            "tone": "neutral"
          },
          {
            "text": "supported fixes",
            "tone": "green"
          },
          {
            "text": "close by.",
            "tone": "neutral"
          }
        ]
      }
    }
  ],
  "content": {
    "overview": "registry-content/overview.md",
    "changelog": "CHANGELOG.md"
  }
}
