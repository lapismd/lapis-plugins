{
  "name": "@lapis-notes/csv",
  "version": "0.2.0",
  "description": "CSV and TSV table view and note embed for Lapis applications",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "prepack": "svelte-package --input src --tsconfig ./tsconfig.pack.json && publint",
    "publint": "publint",
    "pack": "pnpm pack --pack-destination ../../.release/npm"
  },
  "files": [
    "dist",
    "manifest.json",
    "registry.json",
    "registry-content",
    "styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./styles.css": "./styles.css",
    "./registry.json": "./registry.json"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/helpers": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@lapismd/design-core": "^0.7.0",
    "@lucide/svelte": "^0.523.0",
    "@tanstack/virtual-core": "^3.13.12",
    "papaparse": "^5.5.2"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lapis-notes/api": "^0.2.0",
    "@lapis-notes/ui": "^0.1.4",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.2",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/papaparse": "^5.3.16",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugins.git",
    "directory": "packages/csv"
  },
  "homepage": "https://github.com/lapismd/lapis-plugins/tree/main/packages/csv#readme",
  "bugs": {
    "url": "https://github.com/lapismd/lapis-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
