{
  "id": "wordcount",
  "name": "Word Count",
  "version": "0.1.1",
  "minAppVersion": "0.1.0",
  "description": "Status bar word and character count",
  "author": "Lapis Notes",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
