{
  "$schema": "https://registry.lapis.md/schemas/plugin-source.schema.json",
  "schemaVersion": 2,
  "categories": ["writing"],
  "highlights": [
    "Read a Markdown transcript as speaker turns.",
    "Keep comments beside the phrase they mark.",
    "Leave the note body as ordinary Markdown."
  ],
  "documentationUrl": "https://github.com/lapismd/lapis-plugins/tree/main/packages/transcripts#readme",
  "appearance": {
    "icon": "file-text",
    "accent": "#8B5CF6"
  },
  "media": {
    "banner": {
      "alt": "Lapis Transcripts showing a spoken Markdown note with both sidebars closed, speaker turns, a comment, and playback controls.",
      "images": {
        "preview": {
          "path": "registry-assets/banner.preview.webp"
        },
        "full": {
          "path": "registry-assets/banner.full.webp"
        },
        "light": {
          "path": "registry-assets/banner.light.webp"
        },
        "dark": {
          "path": "registry-assets/banner.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-transcripts-registry-screenshots--overview",
        "focus": "full-shell"
      }
    }
  },
  "gallery": [
    {
      "id": "embedded-note",
      "alt": "A meeting note with both sidebars closed, embedding the spoken contract transcript beneath a short introduction.",
      "images": {
        "preview": {
          "path": "registry-assets/gallery/embedded-note.preview.webp"
        },
        "full": {
          "path": "registry-assets/gallery/embedded-note.full.webp"
        },
        "light": {
          "path": "registry-assets/gallery/embedded-note.light.webp"
        },
        "dark": {
          "path": "registry-assets/gallery/embedded-note.dark.webp"
        }
      },
      "capture": {
        "storyId": "plugins-transcripts-registry-screenshots--embedded",
        "focus": "full-shell"
      },
      "card": {
        "headline": [
          {
            "text": "Embed the call",
            "tone": "neutral"
          },
          {
            "text": "in place",
            "tone": "violet"
          }
        ],
        "description": [
          {
            "text": "Open a",
            "tone": "neutral"
          },
          {
            "text": "note",
            "tone": "violet"
          },
          {
            "text": "and keep the",
            "tone": "neutral"
          },
          {
            "text": "spoken call",
            "tone": "cyan"
          },
          {
            "text": "inside it.",
            "tone": "neutral"
          }
        ]
      }
    }
  ]
}
