{
  "id": "community",
  "name": "Community",
  "version": "0.1.0",
  "minAppVersion": "0.1.0",
  "description": "Join Lapis community conversations with a host-owned Nostr identity",
  "author": "Lapis Notes",
  "authorAvatarUrl": "https://gravatar.com/avatar/f7226d5f9cf07af2a6a60d3ab11413abb9d2e2eb60f2d5cce17356845a166155?size=256&d=initials",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
