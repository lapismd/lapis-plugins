[
  {
    "name": "ordered node fields and edge labels",
    "content": "{\"nodes\":[{\"type\":\"text\",\"text\":\"# Plan\",\"label\":\"Node\",\"file\":\"Notes/Target.md\",\"url\":\"https://lapis.md\"},{\"type\":\"file\",\"file\":\"B.md\"}],\"edges\":[{\"label\":\"first edge\"},{\"label\":\"second edge\"}]}",
    "expected": "text\n# Plan\nNode\nNotes/Target.md\nhttps://lapis.md\nfile\nB.md\nfirst edge\nsecond edge"
  },
  {
    "name": "empty object",
    "content": "{}",
    "expected": ""
  },
  {
    "name": "missing node collection",
    "content": "{\"edges\":[{\"label\":\"link\"}]}",
    "expected": "link"
  },
  {
    "name": "missing edge collection",
    "content": "{\"nodes\":[{\"text\":\"note\"}]}",
    "expected": "note"
  },
  {
    "name": "null collections",
    "content": "{\"nodes\":null,\"edges\":null}",
    "expected": ""
  },
  {
    "name": "empty collections",
    "content": "{\"nodes\":[],\"edges\":[]}",
    "expected": ""
  },
  {
    "name": "unknown fields",
    "content": "{\"id\":\"ignored\",\"nodes\":[{\"id\":\"ignored\",\"text\":\"Keep\",\"color\":\"red\"}]}",
    "expected": "Keep"
  },
  {
    "name": "unchanged whitespace inside kept values",
    "content": "{\"nodes\":[{\"text\":\"  retained  \",\"label\":\"\\n label\\t\"}]}",
    "expected": "  retained  \n\n label\t"
  },
  {
    "name": "blank fields",
    "content": "{\"nodes\":[{\"type\":\"  \",\"text\":\"\\t\\n\",\"label\":\" ﻿\",\"file\":\"\",\"url\":\"  \"}]}",
    "expected": ""
  },
  {
    "name": "nel remains nonblank",
    "content": "{\"nodes\":[{\"text\":\"\"}]}",
    "expected": ""
  },
  {
    "name": "unicode text",
    "content": "{\"nodes\":[{\"text\":\"Café 📝 日本語\",\"file\":\"文書/α.md\"}],\"edges\":[{\"label\":\"↗\"}]}",
    "expected": "Café 📝 日本語\n文書/α.md\n↗"
  },
  {
    "name": "line endings",
    "content": "{\"nodes\":[{\"text\":\"a\\r\\nb\\nc\\rd\"}]}",
    "expected": "a\r\nb\nc\rd"
  },
  {
    "name": "duplicate text retained",
    "content": "{\"nodes\":[{\"text\":\"same\"},{\"text\":\"same\"}],\"edges\":[{\"label\":\"same\"}]}",
    "expected": "same\nsame\nsame"
  },
  {
    "name": "falsy field values",
    "content": "{\"nodes\":[{\"type\":false,\"text\":0,\"label\":null,\"file\":\"keep\",\"url\":\"\"}],\"edges\":[{\"label\":false}]}",
    "expected": "{\"nodes\":[{\"type\":false,\"text\":0,\"label\":null,\"file\":\"keep\",\"url\":\"\"}],\"edges\":[{\"label\":false}]}"
  },
  {
    "name": "truthy numeric field falls back",
    "content": "{\"nodes\":[{\"text\":42}]}",
    "expected": "{\"nodes\":[{\"text\":42}]}"
  },
  {
    "name": "truthy boolean field falls back",
    "content": "{\"nodes\":[{\"text\":true}]}",
    "expected": "{\"nodes\":[{\"text\":true}]}"
  },
  {
    "name": "array field falls back",
    "content": "{\"nodes\":[{\"text\":[]}]}",
    "expected": "{\"nodes\":[{\"text\":[]}]}"
  },
  {
    "name": "object field falls back",
    "content": "{\"nodes\":[{\"text\":{}}]}",
    "expected": "{\"nodes\":[{\"text\":{}}]}"
  },
  {
    "name": "null node falls back",
    "content": "{\"nodes\":[{\"text\":\"first\"},null]}",
    "expected": "{\"nodes\":[{\"text\":\"first\"},null]}"
  },
  {
    "name": "null edge falls back",
    "content": "{\"nodes\":[{\"text\":\"first\"}],\"edges\":[null]}",
    "expected": "{\"nodes\":[{\"text\":\"first\"}],\"edges\":[null]}"
  },
  {
    "name": "primitive nodes ignored",
    "content": "{\"nodes\":[1,false,\"text\",[]]}",
    "expected": ""
  },
  {
    "name": "primitive edges ignored",
    "content": "{\"edges\":[1,false,\"text\",[]]}",
    "expected": ""
  },
  {
    "name": "false node collection falls back",
    "content": "{\"nodes\":false}",
    "expected": "{\"nodes\":false}"
  },
  {
    "name": "false edge collection falls back",
    "content": "{\"edges\":false}",
    "expected": "{\"edges\":false}"
  },
  {
    "name": "object node collection falls back",
    "content": "{\"nodes\":{}}",
    "expected": "{\"nodes\":{}}"
  },
  {
    "name": "object edge collection falls back",
    "content": "{\"edges\":{}}",
    "expected": "{\"edges\":{}}"
  },
  {
    "name": "string node collection falls back",
    "content": "{\"nodes\":\"node\"}",
    "expected": "{\"nodes\":\"node\"}"
  },
  {
    "name": "string edge collection falls back",
    "content": "{\"edges\":\"edge\"}",
    "expected": "{\"edges\":\"edge\"}"
  },
  {
    "name": "null document falls back",
    "content": "null",
    "expected": "null"
  },
  {
    "name": "array document",
    "content": "[]",
    "expected": ""
  },
  {
    "name": "boolean document",
    "content": "false",
    "expected": ""
  },
  {
    "name": "numeric document",
    "content": "17",
    "expected": ""
  },
  {
    "name": "string document",
    "content": "\"note\"",
    "expected": ""
  },
  {
    "name": "invalid json",
    "content": "{\"nodes\": [}",
    "expected": "{\"nodes\": [}"
  },
  {
    "name": "plain source fallback",
    "content": "not a canvas\n# text",
    "expected": "not a canvas\n# text"
  },
  {
    "name": "empty source",
    "content": "",
    "expected": ""
  },
  {
    "name": "duplicate JSON fields use the last",
    "content": "{\"nodes\":[{\"text\":\"old\",\"text\":\"new\"}],\"edges\":[{\"label\":\"edge\"}]}",
    "expected": "new\nedge"
  }
]
